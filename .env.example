# скопируй в .env или задай в терминале; .env в git не попадает
BOT_TOKEN=123456:ABC-токен-от-BotFather
MODEL_PATH=model.joblib
NUTRIENTS_PATH=nutrients.csv
DB_PATH=finediet.db
# ---------- агент-нутрициолог (необязательно): любая модель с OpenAI-совместимым API ----------
# Вариант 1. Ollama на своём компьютере: бесплатно, данные не уходят, но на слабом ноутбуке медленно.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-3b-cpu
LLM_API_KEY=ollama
LLM_FAST_TIMEOUT=150

# Вариант 2. Облачная модель: ответы за секунды и заметно умнее (сама выбирает инструменты, пишет рецепты).
# Вопросы и сводка покупок уходят провайдеру; запросы платные. Раскомментируй ОДИН блок и закомментируй вариант 1.
#   Claude (совместимость с OpenAI SDK; имена моделей — в документации Anthropic):
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=ключ-из-console.anthropic.com
#   OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=имя-модели-из-документации-OpenAI
# LLM_API_KEY=sk-...
#   OpenRouter (много моделей через один ключ):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=имя-модели-из-каталога-OpenRouter
# LLM_API_KEY=sk-or-...

# Режимы (auto = по умолчанию: для Ollama — быстрый путь и рецепты шаблоном, для облака — наоборот):
# LLM_FAST_PATH=auto
# RECIPES_LLM=auto
# LLM_MAX_TOKENS=1200
# LLM_HEADERS=anthropic-workspace-id:...   # только если провайдер требует доп. заголовок

# фото чеков (необязательно): нейросеть со зрением в Ollama, например qwen2.5vl:7b
# LLM_VISION_MODEL=qwen2.5vl:7b
# или Tesseract OCR (Windows: путь к tesseract.exe, если не стандартный)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
